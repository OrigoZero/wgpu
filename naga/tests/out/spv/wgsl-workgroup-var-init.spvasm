; Version: 1.1
; Generator: rspirv
; Bound: 553
OpCapability Shader
OpExtension "SPV_KHR_storage_buffer_storage_class"
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %20 "main" %27
OpExecutionMode %20 LocalSize 1 1 1
%3 = OpString "workgroup-var-init.wgsl"
OpSource Unknown 0 %3 "struct WStruct {
    arr: array<u32, 512>,
    atom: atomic<i32>,
    atom_arr: array<array<atomic<i32>, 8>, 8>,
}

var<workgroup> w_mem: WStruct;

@group(0) @binding(0)
var<storage, read_write> output: array<u32, 512>;

@compute @workgroup_size(1)
fn main() {
    output = w_mem.arr;
}"
